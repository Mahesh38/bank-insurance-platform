# Copy to .env and fill before `docker compose up`. Never commit the real .env.

# Postgres (bank-persistence-service datastore)
POSTGRES_PASSWORD=changeme_local_only

# AES-256 key for raw_payload encryption at rest (COMP-003) — base64, decodes to 32 bytes.
# Generate one with: openssl rand -base64 32
RAW_PAYLOAD_ENCRYPTION_KEY=

# 1SB sandbox credentials (1sb-integration-service)
ONESB_API_KEY=
ONESB_API_SECRET=
ONESB_DISTRIBUTOR_ID=
ONESB_BASE_URL=https://demo.api.1silverbullet.tech
