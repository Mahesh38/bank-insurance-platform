# Local identity stack only. Copy to .env.identity and change values when sharing an environment.
KEYCLOAK_DB_PASSWORD=keycloak_local_only
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin_local_only
KEYCLOAK_BFF_CLIENT_SECRET=local-workforce-bff-secret
KEYCLOAK_PROVIDER_ADAPTER_SECRET=local-provider-adapter-secret
AUTHZ_DB_PASSWORD=authz_local_only
REDIS_PASSWORD=redis_local_only

# Base64-encoded 32-byte AES key. Generate a new value for every non-local environment.
# openssl rand -base64 32
WORKFORCE_SESSION_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
