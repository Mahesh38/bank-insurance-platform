# =============================================================================
# .env.example — 1SB Integration Service
#
# Copy this file to .env (or .env.local) and populate with real values.
# NEVER commit a file containing real values to git.
# For CI/CD, inject these as pipeline secrets or vault-injected env vars.
#
# Vault path convention (placeholder — confirm with Platform team):
#   sandbox : secret/onesb/sandbox/<key-name>
#   prod    : secret/onesb/prod/<key-name>
#
# See docs/1sb-insurance-integration/service-ssot/phase-0/CONFIRM-01-onesb-access.md
# for the confirmation checklist and owner assignments.
# =============================================================================

# ── 1SB API Credentials ───────────────────────────────────────────────────────
# Provided by 1SB during distributor onboarding.
# Used as HTTP Basic Auth: Authorization: Basic base64(ONESB_API_KEY:ONESB_API_SECRET)
ONESB_API_KEY=<your-api-key-here>
ONESB_API_SECRET=<your-api-secret-here>

# ── Distributor Identity ───────────────────────────────────────────────────────
# Assigned by 1SB to your bank/distributor entity.
# Sent as a field in every API request body (distributorId / agentId context).
ONESB_DISTRIBUTOR_ID=<your-distributor-id-here>

# ── Base URL (optional override) ──────────────────────────────────────────────
# Defaults are baked into provider-config.yml per profile.
# Set this only if you need to override (e.g., a specific sandbox sub-domain).
# ONESB_BASE_URL=https://sandbox.1silverbullet.tech

# ── Spring Profile ─────────────────────────────────────────────────────────────
# Controls which profile overlay in provider-config.yml is active.
# Values: sandbox | prod
SPRING_PROFILES_ACTIVE=sandbox

# ── Database (application-level — adjust to your local setup) ─────────────────
# DB_URL=jdbc:postgresql://localhost:5432/insurance_integration
# DB_USERNAME=<db-user>
# DB_PASSWORD=<db-password>

# ── Vault / Secrets Backend (optional — only if using HashiCorp Vault) ────────
# VAULT_ADDR=https://vault.internal.bank.example.com
# VAULT_TOKEN=<vault-token>  # prefer AppRole or k8s SA auth in production
