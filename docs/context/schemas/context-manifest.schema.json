{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-module/schemas/context-manifest.schema.json",
  "title": "Portable Context Module Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "module_version", "project", "authority", "layers", "roles", "loading_profiles", "portability"],
  "properties": {
    "schema_version": {"type": "string"},
    "module_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "domain", "problem_statement", "repository_root"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "name": {"type": "string", "minLength": 1},
        "domain": {"type": "string", "minLength": 1},
        "problem_statement": {"type": "string", "minLength": 1},
        "repository_root": {"type": "string", "minLength": 1}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context_is_binding", "canonical_authority", "precedence"],
      "properties": {
        "context_is_binding": {"const": false},
        "canonical_authority": {"type": "string", "minLength": 1},
        "precedence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "path", "portable", "authority"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "kind": {"enum": ["boot", "routing", "framework", "project", "domain", "role", "protocol", "roadmap"]},
          "path": {"type": "string", "minLength": 1},
          "portable": {"type": "boolean"},
          "authority": {"enum": ["none", "context", "binding-reference"]}
        }
      }
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "package", "governance_role", "governance_status", "decision_ref", "aliases"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "name": {"type": "string", "minLength": 1},
          "package": {"type": "string", "minLength": 1},
          "governance_role": {"type": "string", "minLength": 1},
          "governance_status": {"enum": ["active", "candidate", "retired"]},
          "decision_ref": {"type": "string", "minLength": 1},
          "aliases": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "loading_profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "purpose", "include"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "purpose": {"type": "string", "minLength": 1},
          "resolver": {"type": "string", "minLength": 1},
          "include": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^(layer|role):[a-z0-9-]+$"}}
        }
      }
    },
    "portability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scaffold_template", "scaffold_command", "validate_command", "excluded_from_reuse"],
      "properties": {
        "scaffold_template": {"type": "string", "minLength": 1},
        "scaffold_command": {"type": "string", "minLength": 1},
        "validate_command": {"type": "string", "minLength": 1},
        "excluded_from_reuse": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
