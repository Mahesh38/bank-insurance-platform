{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bank-insurance-platform/governance/schemas/implementation-plan.schema.json",
  "title": "AIGEM Implementation Plan",
  "description": "The artefact the review boards judge. files_expected and out_of_scope form the contract that drift control measures against.",
  "type": "object",
  "required": [
    "id", "work_item", "risk_tier", "author", "objective", "problem", "proposed_solution",
    "affected_components", "files_expected", "data_changes", "api_changes", "security_impact",
    "compliance_impact", "backward_compatibility", "testing", "rollback", "acceptance_criteria",
    "out_of_scope"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^PLAN-[0-9]{3}$" },
    "work_item": { "type": "string" },
    "origin": { "type": ["string", "null"] },
    "workstream": { "type": "string" },
    "risk_tier": { "enum": ["T1", "T2", "T3", "T4"] },
    "author": { "type": "string" },
    "date": { "type": "string", "format": "date" },

    "objective": { "type": "string", "minLength": 1, "description": "One sentence: what is true after this change that is not true now." },
    "problem": { "type": "string", "minLength": 1, "description": "Current state plus evidence. Not 'it would be better if'." },
    "proposed_solution": { "type": "string", "minLength": 1 },

    "alternatives": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["option", "rejected_because"],
        "additionalProperties": false,
        "properties": {
          "option": { "type": "string" },
          "rejected_because": { "type": "string" }
        }
      }
    },

    "affected_components": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "files_expected": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "Named files. 'various files' means you are not ready to plan — spike first."
    },

    "data_changes": { "type": "string", "description": "none | schema | migration | backfill (+ detail)" },
    "api_changes": { "type": "string", "description": "none | additive | breaking (+ contract detail)" },
    "security_impact": { "type": "string", "description": "none | authn | authz | secrets | crypto | PII | attack-surface" },
    "compliance_impact": { "type": "string", "description": "none | consent | retention | audit | attribution | reporting" },
    "backward_compatibility": { "type": "string", "description": "compatible | deprecating | breaking (+ migration path)" },
    "performance_impact": { "type": "string" },
    "operational_impact": { "type": "string" },

    "testing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "unit": { "type": "array", "items": { "type": "string" } },
        "integration": { "type": "array", "items": { "type": "string" } },
        "e2e": { "type": "array", "items": { "type": "string" } },
        "other": { "type": "array", "items": { "type": "string" } }
      }
    },

    "rollback": { "type": "string", "minLength": 1, "description": "Whether revert is sufficient, given data written and contracts published." },

    "dependencies": { "type": "array", "items": { "type": "string" } },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["risk"],
        "additionalProperties": false,
        "properties": {
          "risk": { "type": "string" },
          "mitigation": { "type": "string" }
        }
      }
    },

    "acceptance_criteria": { "type": "array", "minItems": 1, "items": { "type": "string" } },

    "out_of_scope": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "Rule IP-2: mandatory and non-empty for T2+. List the most tempting adjacent changes."
    },

    "estimate": { "enum": ["XS", "S", "M", "L", "XL"] },

    "reviews": {
      "type": "array",
      "items": { "$ref": "review-verdict.schema.json" }
    },

    "variance_log": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "change", "reason"],
        "additionalProperties": false,
        "properties": {
          "date": { "type": "string", "format": "date" },
          "change": { "type": "string" },
          "reason": { "type": "string" },
          "re_review": { "type": "string" }
        }
      },
      "description": "10 §6. Rule DC-2: editing files_expected to match what you already changed is not a variance log."
    }
  }
}
