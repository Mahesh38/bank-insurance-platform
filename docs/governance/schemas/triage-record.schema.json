{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bank-insurance-platform/governance/schemas/triage-record.schema.json",
  "title": "AIGEM Triage Record",
  "description": "Output of the AIGEM decision pipeline for one input. Produced for every requirement, bug, suggestion, or finding before any code is written.",
  "type": "object",
  "required": ["id", "raised_at", "raised_by", "input", "context", "stage_fit", "scope", "necessity", "action"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^SUG-[0-9]{4}$" },
    "raised_at": { "type": "string", "format": "date" },
    "raised_by": { "type": "string", "description": "agent:<name> | human:<name> | scan:<tool>" },
    "source": { "type": "string" },
    "input": { "type": "string", "minLength": 1, "description": "Verbatim. Do not paraphrase into something more reasonable than what was said." },

    "context": {
      "type": "object",
      "required": ["workstream", "current_phase"],
      "additionalProperties": false,
      "properties": {
        "workstream": { "type": "string" },
        "current_phase": { "type": "string" },
        "canonical_stage": { "type": "string" },
        "current_objective": { "type": "string" },
        "state_as_of": { "type": "string", "format": "date" },
        "state_provisional": { "type": "boolean" },
        "active_work_item": { "type": ["string", "null"] }
      }
    },

    "stage_fit": {
      "type": "object",
      "required": ["code", "rationale"],
      "additionalProperties": false,
      "properties": {
        "code": { "enum": ["SF0", "SF1", "SF2", "SF3", "SF4"] },
        "rationale": { "type": "string", "minLength": 1 },
        "target_stage": { "type": ["string", "null"] },
        "unpark_trigger": { "type": ["string", "null"] },
        "absorption_test": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "small": { "type": ["boolean", "null"] },
            "no_new_dependency": { "type": ["boolean", "null"] },
            "no_new_decision": { "type": ["boolean", "null"] },
            "gate_neutral": { "type": ["boolean", "null"] }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "code": { "const": "SF3" } } },
          "then": {
            "required": ["target_stage", "unpark_trigger"],
            "properties": {
              "target_stage": { "type": "string", "minLength": 1 },
              "unpark_trigger": { "type": "string", "minLength": 1 }
            },
            "description": "Rule 03 §3: an SF3 park without a target stage and an unpark trigger is not parked, it is lost."
          }
        },
        {
          "if": { "properties": { "code": { "const": "SF2" } } },
          "then": { "required": ["absorption_test"] }
        }
      ]
    },

    "scope": {
      "type": "object",
      "required": ["code"],
      "additionalProperties": false,
      "properties": {
        "code": { "enum": ["SC0", "SC1", "SC2", "SC3", "SC4"] },
        "business_scope": { "type": "string" },
        "serves": { "type": "array", "items": { "type": "string" } },
        "failure_without_it": { "type": "string" },
        "minimal": { "type": "boolean" },
        "authority": { "type": "string" }
      },
      "if": { "properties": { "code": { "const": "SC1" } } },
      "then": {
        "required": ["serves", "failure_without_it"],
        "properties": { "serves": { "minItems": 1 } },
        "description": "Rule SC-1: derived necessity must name its beneficiary."
      }
    },

    "necessity": {
      "type": "object",
      "required": ["now", "confidence"],
      "additionalProperties": false,
      "properties": {
        "now": { "enum": ["MUST", "SHOULD", "COULD", "NOT-NOW", "REJECT"] },
        "future_necessity": { "enum": ["MUST", "SHOULD", "COULD", null] },
        "target_stage": { "type": ["string", "null"] },
        "binds_when": { "type": ["string", "null"] },
        "failure_without_it": { "type": "string" },
        "evidence_tier": { "enum": ["E1", "E2", "E3", "E4", "E5", "E6", "E7"] },
        "evidence": { "type": "array", "items": { "type": "string" } },
        "confidence": { "enum": ["C1", "C2", "C3", "C4", "C5"] },
        "assumptions": { "type": "array", "items": { "type": "string", "pattern": "^ASM-[0-9]{3}$" } },
        "anti_over_engineering": {
          "type": "object",
          "additionalProperties": { "type": ["boolean", "null"] },
          "description": "X1..X10 tests from 16 §6"
        }
      },
      "allOf": [
        {
          "if": { "properties": { "now": { "const": "NOT-NOW" } } },
          "then": {
            "required": ["future_necessity", "target_stage"],
            "description": "NOT-NOW is a scheduled MUST/SHOULD, not a soft reject."
          }
        },
        {
          "if": { "properties": { "now": { "const": "MUST" } } },
          "then": {
            "required": ["failure_without_it", "evidence_tier"],
            "properties": { "evidence_tier": { "enum": ["E1", "E2", "E3", "E4", "E5"] } },
            "description": "Rule EV-1: a MUST resting on E6/E7 evidence downgrades to SHOULD."
          }
        }
      ]
    },

    "action": { "enum": ["ADMIT", "ADMIT-BYPASS", "PARK", "REJECT", "ESCALATE"] },
    "action_rationale": { "type": "string" },
    "duplicate_of": { "type": ["string", "null"] },
    "recurrence_count": { "type": "integer", "minimum": 1 },
    "conflicts": { "type": "array", "items": { "type": "string" } },
    "reopen_if": { "type": "string", "description": "Mandatory on REJECT: converts 'no' into 'not unless'." },
    "bypass_authorised_by": { "type": "string" },

    "classification": {
      "type": "object",
      "required": ["type", "breakdown", "risk_tier"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["FUNC", "BUG", "NFR", "ARCH", "SEC", "COMP", "INFRA", "DEBT", "REFACTOR", "QA", "OPS", "SPIKE", "DOC", "MIGRATION", "GOV", "IDEA"] },
        "also": { "type": "array", "items": { "type": "string" } },
        "breakdown": { "enum": ["EPIC", "STORY", "TASK", "SPIKE", "ADR"] },
        "epic": { "type": ["string", "null"] },
        "risk_tier": { "enum": ["T1", "T2", "T3", "T4"] },
        "rationale": { "type": "string" },
        "destination": { "type": "string" }
      }
    },

    "priority": {
      "type": "object",
      "required": ["now"],
      "additionalProperties": false,
      "properties": {
        "now": { "enum": ["P1", "P2", "P3", "P4", "P5"] },
        "at_target": { "enum": ["P1", "P2", "P3", "P4", "P5", null] },
        "factors": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "N": { "type": "integer", "minimum": 0, "maximum": 4 },
            "S": { "type": "integer", "minimum": 0, "maximum": 4 },
            "B": { "type": "integer", "minimum": 0, "maximum": 3 },
            "R": { "type": "integer", "minimum": 0, "maximum": 3 },
            "D": { "type": "integer", "minimum": 0, "maximum": 2 },
            "E": { "type": "integer", "minimum": 0, "maximum": 3 }
          }
        },
        "score": { "type": "integer", "minimum": -3, "maximum": 30 },
        "matrix_default": { "enum": ["P1", "P2", "P3", "P4", "P5"] },
        "consistency": { "enum": ["OK", "RECHECK"] },
        "overrides_applied": { "type": "array", "items": { "enum": ["O1", "O2", "O3", "O4", "O5", "O6", "O7", "O8"] } },
        "override_evidence": { "type": "array", "items": { "type": "string" } },
        "caps_applied": { "type": "array", "items": { "type": "string" } },
        "rationale": { "type": "string" }
      },
      "if": { "properties": { "overrides_applied": { "minItems": 1 } }, "required": ["overrides_applied"] },
      "then": {
        "required": ["override_evidence"],
        "properties": { "override_evidence": { "minItems": 1 } },
        "description": "05 §3: an unevidenced P1 override claim is downgraded and counted as a false-P1."
      }
    },

    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "target", "relation"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^DEP-[0-9]{3}$" },
              "type": { "enum": ["HARD", "SOFT", "TECHNICAL", "BUSINESS", "EXTERNAL", "ARCHITECTURAL", "DATA", "SECURITY", "COMPLIANCE", "ENVIRONMENT", "DECISION"] },
              "target": { "type": "string" },
              "relation": { "enum": ["blocked_by", "requires", "enables", "related_to", "external", "decision_dependency"] },
              "state": { "enum": ["DONE", "READY", "IN-FLIGHT", "BLOCKED", "PARKED", "OPEN", "MISSING"] },
              "owner": { "type": "string" },
              "follow_up": { "type": "string", "format": "date" }
            },
            "if": { "properties": { "type": { "const": "EXTERNAL" } } },
            "then": {
              "required": ["owner", "follow_up"],
              "description": "Rule DEP-3: external dependencies get a name and a date, or they are not tracked."
            }
          }
        },
        "state": { "enum": ["READY", "BLOCKED", "PARKED-DEPENDENT"] },
        "enablement_count": { "type": "integer", "minimum": 0 },
        "earliest_start": { "type": "string" },
        "parked_because": { "type": "string" },
        "cycles": { "type": ["string", "array"] }
      }
    },

    "breakdown": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "children": { "type": "array", "items": { "type": "string" } },
        "completion_definition": { "type": ["string", "null"] },
        "not_included": { "type": "array", "items": { "type": "string" } }
      }
    },

    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "registered_in": { "type": "string" },
        "work_item_id": { "type": ["string", "null"] },
        "plan_id": { "type": ["string", "null"] },
        "status": { "enum": ["ADMITTED", "ADMIT-BYPASS", "PARKED", "ESCALATED", "REJECTED", "DUPLICATE", "SUPERSEDED", "LAPSED", "CLOSED-DELIVERED"] },
        "closed_reason": { "type": ["string", "null"] }
      }
    },

    "resumed": {
      "type": ["string", "null"],
      "description": "The work item the agent returned to. 09 §5 — returning to the task is the point of the whole model."
    }
  },

  "allOf": [
    {
      "if": { "properties": { "action": { "const": "ADMIT" } }, "required": ["action"] },
      "then": { "required": ["classification", "priority", "dependencies"] }
    },
    {
      "if": { "properties": { "action": { "const": "REJECT" } }, "required": ["action"] },
      "then": { "required": ["action_rationale", "reopen_if"] }
    },
    {
      "if": { "properties": { "action": { "const": "ADMIT-BYPASS" } }, "required": ["action"] },
      "then": { "required": ["bypass_authorised_by"] }
    }
  ]
}
