{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.bank.internal/events/AuditRecorded.v1.json",
  "title": "AuditRecorded v1 - data",
  "description": "Business-audit evidence row (ADR-026, proposed); actingCapacity is in the envelope actor. Producer: <every service>. Status: PROPOSED (ADR-026). The `data` member of event-envelope/v1 (ADR-025): ids and states only, never customer PII.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action",
    "resourceType",
    "resourceId",
    "outcome"
  ],
  "properties": {
    "action": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9_.-]{0,63}$"
    },
    "resourceType": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9_.-]{0,63}$"
    },
    "resourceId": {
      "type": "string",
      "maxLength": 64
    },
    "outcome": {
      "type": "string",
      "enum": [
        "SUCCESS",
        "DENIED",
        "FAILED"
      ]
    },
    "priorState": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Z][A-Z_]*$",
      "description": "Aggregate state after the change"
    },
    "newState": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Z][A-Z_]*$",
      "description": "Aggregate state after the change"
    },
    "consentRef": {
      "$ref": "#/$defs/ulid"
    },
    "suitabilityRef": {
      "$ref": "#/$defs/ulid"
    },
    "reasonCodes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z0-9][A-Z0-9_.-]{0,63}$"
      }
    }
  },
  "$defs": {
    "ulid": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    }
  }
}
