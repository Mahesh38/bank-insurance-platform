{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.bank.internal/events/ConsentGranted.v1.json",
  "title": "ConsentGranted v1 - data",
  "description": "Customer granted one consent purpose; validUntil null = no expiry (CNS-COM). Producer: consent. Status: CONTRACTED. The `data` member of event-envelope/v1 (ADR-025): ids and states only, never customer PII.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "consentId",
    "customerId",
    "purpose",
    "checkpoint",
    "statementVersion"
  ],
  "properties": {
    "consentId": {
      "$ref": "#/$defs/ulid"
    },
    "customerId": {
      "$ref": "#/$defs/ulid"
    },
    "purpose": {
      "type": "string",
      "enum": [
        "CNS-DP",
        "CNS-SOL",
        "CNS-QSH",
        "CNS-SHR",
        "CNS-COM"
      ],
      "description": "Consent purpose (D5; CNS-QSH = share quote inputs with insurers via 1SB)"
    },
    "checkpoint": {
      "type": "string",
      "enum": [
        "BEFORE_MULTI_QUOTE",
        "BEFORE_PROPOSAL_SUBMIT",
        "BEFORE_FIRST_COMMUNICATION",
        "BEFORE_SUITABILITY"
      ],
      "description": "Checkpoint from rule set CONSENT.POLICY"
    },
    "statementVersion": {
      "type": "string",
      "maxLength": 32
    },
    "validUntil": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "RFC 3339 UTC"
    },
    "insurerCode": {
      "type": "string",
      "pattern": "^[A-Z0-9_]{2,32}$",
      "description": "Insurer code from product-catalogue"
    },
    "otpTxnId": {
      "type": "string",
      "maxLength": 64,
      "description": "OTP transaction reference (not the OTP)"
    }
  },
  "$defs": {
    "ulid": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    }
  }
}
