{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.bank.internal/events/ConsentWithdrawn.v1.json",
  "title": "ConsentWithdrawn v1 - data",
  "description": "Consent withdrawn by the customer or on their behalf. Producer: consent. Status: CONTRACTED. The `data` member of event-envelope/v1 (ADR-025): ids and states only, never customer PII.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "consentId",
    "customerId",
    "purpose",
    "reasonCode",
    "withdrawnAt"
  ],
  "properties": {
    "consentId": {
      "$ref": "#/$defs/ulid"
    },
    "customerId": {
      "$ref": "#/$defs/ulid"
    },
    "purpose": {
      "type": "string",
      "enum": [
        "CNS-DP",
        "CNS-SOL",
        "CNS-QSH",
        "CNS-SHR",
        "CNS-COM"
      ],
      "description": "Consent purpose (D5; CNS-QSH = share quote inputs with insurers via 1SB)"
    },
    "reasonCode": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9_.-]{0,63}$"
    },
    "withdrawnAt": {
      "type": "string",
      "format": "date-time",
      "description": "RFC 3339 UTC"
    }
  },
  "$defs": {
    "ulid": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    }
  }
}
