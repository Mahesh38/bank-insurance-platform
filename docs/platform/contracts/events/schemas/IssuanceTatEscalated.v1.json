{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.bank.internal/events/IssuanceTatEscalated.v1.json",
  "title": "IssuanceTatEscalated v1 - data",
  "description": "Insurer decision clock (PROPOSAL.TAT) reached its warning point or breached. Producer: policy. Status: NEW (D8). The `data` member of event-envelope/v1 (ADR-025): ids and states only, never customer PII.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policyId",
    "proposalId",
    "applicationNumber",
    "level",
    "decisionDays",
    "clockStartedAt"
  ],
  "properties": {
    "policyId": {
      "$ref": "#/$defs/ulid"
    },
    "proposalId": {
      "$ref": "#/$defs/ulid"
    },
    "applicationNumber": {
      "type": "string",
      "maxLength": 64,
      "description": "Insurer application number (insurer-issued reference, not customer data)"
    },
    "level": {
      "type": "string",
      "enum": [
        "WARNING",
        "BREACHED"
      ]
    },
    "decisionDays": {
      "type": "integer",
      "minimum": 1
    },
    "clockStartedAt": {
      "type": "string",
      "format": "date-time",
      "description": "RFC 3339 UTC"
    },
    "journeyId": {
      "$ref": "#/$defs/ulid"
    }
  },
  "$defs": {
    "ulid": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    }
  }
}
