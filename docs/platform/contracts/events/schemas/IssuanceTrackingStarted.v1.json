{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.bank.internal/events/IssuanceTrackingStarted.v1.json",
  "title": "IssuanceTrackingStarted v1 - data",
  "description": "policy-issuance minted policyId and started the PROPOSAL.TAT clock and status polling on PaymentReconciled. Producer: policy. Status: CONTRACTED. The `data` member of event-envelope/v1 (ADR-025): ids and states only, never customer PII.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policyId",
    "proposalId",
    "paymentId",
    "applicationNumber",
    "clockStartedAt",
    "decisionDays"
  ],
  "properties": {
    "policyId": {
      "$ref": "#/$defs/ulid"
    },
    "proposalId": {
      "$ref": "#/$defs/ulid"
    },
    "paymentId": {
      "$ref": "#/$defs/ulid"
    },
    "applicationNumber": {
      "type": "string",
      "maxLength": 64,
      "description": "Insurer application number (insurer-issued reference, not customer data)"
    },
    "clockStartedAt": {
      "type": "string",
      "format": "date-time",
      "description": "RFC 3339 UTC"
    },
    "decisionDays": {
      "type": "integer",
      "minimum": 1
    },
    "pollIntervalHours": {
      "type": "integer",
      "minimum": 1
    },
    "journeyId": {
      "$ref": "#/$defs/ulid"
    }
  },
  "$defs": {
    "ulid": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    }
  }
}
