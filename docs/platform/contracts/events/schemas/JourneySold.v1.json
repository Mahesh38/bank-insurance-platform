{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.bank.internal/events/JourneySold.v1.json",
  "title": "JourneySold v1 - data",
  "description": "Journey reached SOLD (INV-JRN-05). Producer: journey. Status: CONTRACTED. The `data` member of event-envelope/v1 (ADR-025): ids and states only, never customer PII.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "journeyId",
    "leadId",
    "policyId",
    "paymentId"
  ],
  "properties": {
    "journeyId": {
      "$ref": "#/$defs/ulid"
    },
    "leadId": {
      "$ref": "#/$defs/ulid"
    },
    "policyId": {
      "$ref": "#/$defs/ulid"
    },
    "paymentId": {
      "$ref": "#/$defs/ulid"
    }
  },
  "$defs": {
    "ulid": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    }
  }
}
