{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.bank.internal/events/OfferSelected.v1.json",
  "title": "OfferSelected v1 - data",
  "description": "Customer selected one offer (INV-QUO-05). Producer: quotation. Status: IMPLEMENTED (DynamoDB OUTBOX item; envelope pending). The `data` member of event-envelope/v1 (ADR-025): ids and states only, never customer PII.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "quoteId",
    "state"
  ],
  "properties": {
    "quoteId": {
      "$ref": "#/$defs/ulid"
    },
    "state": {
      "type": "string",
      "pattern": "^[A-Z][A-Z_]*$",
      "description": "Aggregate state after the change"
    },
    "journeyId": {
      "$ref": "#/$defs/ulid"
    },
    "offerId": {
      "$ref": "#/$defs/ulid"
    },
    "insurerCode": {
      "type": "string",
      "pattern": "^[A-Z0-9_]{2,32}$",
      "description": "Insurer code from product-catalogue"
    }
  },
  "$defs": {
    "ulid": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    }
  }
}
