{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.bank.internal/events/PartnerUserCreated.v1.json",
  "title": "PartnerUserCreated v1 - data",
  "description": "A bank admin created an insurer partner user (E5, no approval step by default). Never carries name, email or mobile. Producer: identity. Status: CONTRACTED. The `data` member of event-envelope/v1 (ADR-025): ids and states only, never customer PII.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "partnerUserId",
    "insurerCode",
    "roles",
    "approvalRequired"
  ],
  "properties": {
    "partnerUserId": {
      "$ref": "#/$defs/ulid"
    },
    "insurerCode": {
      "type": "string",
      "maxLength": 32
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z_]*$"
      },
      "minItems": 1
    },
    "approvalRequired": {
      "type": "boolean",
      "description": "identity.partner-onboarding.approval-required at creation time (default false)"
    }
  },
  "$defs": {
    "ulid": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    }
  }
}
