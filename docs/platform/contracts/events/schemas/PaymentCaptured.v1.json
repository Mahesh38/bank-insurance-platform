{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.bank.internal/events/PaymentCaptured.v1.json",
  "title": "PaymentCaptured v1 - data",
  "description": "Funds captured. Producer: payment. Status: CONTRACTED. The `data` member of event-envelope/v1 (ADR-025): ids and states only, never customer PII.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "paymentId",
    "pgTxnId",
    "amount",
    "currency"
  ],
  "properties": {
    "paymentId": {
      "$ref": "#/$defs/ulid"
    },
    "pgTxnId": {
      "type": "string",
      "maxLength": 64,
      "description": "Payment-gateway transaction reference"
    },
    "amount": {
      "type": "string",
      "pattern": "^\\d{1,13}(\\.\\d{1,2})?$",
      "description": "Decimal amount as a string (no float rounding), rupees"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$",
      "description": "ISO 4217"
    },
    "journeyId": {
      "$ref": "#/$defs/ulid"
    },
    "method": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9_.-]{0,63}$"
    },
    "paidAt": {
      "type": "string",
      "format": "date-time",
      "description": "RFC 3339 UTC"
    }
  },
  "$defs": {
    "ulid": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    }
  }
}
