{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.bank.internal/events/PaymentExpired.v1.json",
  "title": "PaymentExpired v1 - data",
  "description": "Payment link expired unpaid. Producer: payment. Status: CONTRACTED. The `data` member of event-envelope/v1 (ADR-025): ids and states only, never customer PII.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "paymentId"
  ],
  "properties": {
    "paymentId": {
      "$ref": "#/$defs/ulid"
    },
    "journeyId": {
      "$ref": "#/$defs/ulid"
    },
    "quoteId": {
      "$ref": "#/$defs/ulid"
    },
    "proposalId": {
      "$ref": "#/$defs/ulid"
    }
  },
  "$defs": {
    "ulid": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    }
  }
}
