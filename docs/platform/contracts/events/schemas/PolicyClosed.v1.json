{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.bank.internal/events/PolicyClosed.v1.json",
  "title": "PolicyClosed v1 - data",
  "description": "The POLICY tracking aggregate reached a terminal state; no further status polling. Producer: policy. Status: CONTRACTED. The `data` member of event-envelope/v1 (ADR-025): ids and states only, never customer PII.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policyId",
    "finalState"
  ],
  "properties": {
    "policyId": {
      "$ref": "#/$defs/ulid"
    },
    "proposalId": {
      "$ref": "#/$defs/ulid"
    },
    "finalState": {
      "type": "string",
      "enum": [
        "ISSUED",
        "ISSUANCE_FAILED",
        "REFUNDED",
        "CANCELLED"
      ]
    },
    "reasonCode": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9_.-]{0,63}$"
    },
    "journeyId": {
      "$ref": "#/$defs/ulid"
    }
  },
  "$defs": {
    "ulid": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    }
  }
}
