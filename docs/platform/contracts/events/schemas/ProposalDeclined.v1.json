{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.bank.internal/events/ProposalDeclined.v1.json",
  "title": "ProposalDeclined v1 - data",
  "description": "Insurer declined after payment; refund follows (D8). Producer: policy. Status: NEW (D8). The `data` member of event-envelope/v1 (ADR-025): ids and states only, never customer PII.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policyId",
    "proposalId",
    "applicationNumber",
    "journeyId",
    "reasonCode"
  ],
  "properties": {
    "policyId": {
      "$ref": "#/$defs/ulid"
    },
    "proposalId": {
      "$ref": "#/$defs/ulid"
    },
    "applicationNumber": {
      "type": "string",
      "maxLength": 64,
      "description": "Insurer application number (insurer-issued reference, not customer data)"
    },
    "journeyId": {
      "$ref": "#/$defs/ulid"
    },
    "reasonCode": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9_.-]{0,63}$"
    }
  },
  "$defs": {
    "ulid": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    }
  }
}
