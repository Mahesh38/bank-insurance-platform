{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.bank.internal/events/ProposalExpired.v1.json",
  "title": "ProposalExpired v1 - data",
  "description": "Proposal abandoned or its quote expired before payment; it can no longer proceed. Producer: proposal. Status: CONTRACTED. The `data` member of event-envelope/v1 (ADR-025): ids and states only, never customer PII.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "proposalId",
    "previousState",
    "reasonCode"
  ],
  "properties": {
    "proposalId": {
      "$ref": "#/$defs/ulid"
    },
    "previousState": {
      "type": "string",
      "pattern": "^[A-Z][A-Z_]*$"
    },
    "reasonCode": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9_.-]{0,63}$"
    },
    "quoteId": {
      "$ref": "#/$defs/ulid"
    },
    "journeyId": {
      "$ref": "#/$defs/ulid"
    }
  },
  "$defs": {
    "ulid": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    }
  }
}
