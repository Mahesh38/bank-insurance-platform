{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.bank.internal/events/QuoteConverted.v1.json",
  "title": "QuoteConverted v1 - data",
  "description": "Structured quote + offers materialised on PaymentReconciled; quote SELECTED -> CONVERTED (D8). Producer: quotation. Status: NEW (D8). The `data` member of event-envelope/v1 (ADR-025): ids and states only, never customer PII.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "quoteId",
    "selectedOfferId",
    "paymentId",
    "journeyId"
  ],
  "properties": {
    "quoteId": {
      "$ref": "#/$defs/ulid"
    },
    "selectedOfferId": {
      "$ref": "#/$defs/ulid"
    },
    "paymentId": {
      "$ref": "#/$defs/ulid"
    },
    "journeyId": {
      "$ref": "#/$defs/ulid"
    }
  },
  "$defs": {
    "ulid": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    }
  }
}
