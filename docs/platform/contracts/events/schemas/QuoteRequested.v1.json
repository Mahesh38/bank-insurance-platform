{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.bank.internal/events/QuoteRequested.v1.json",
  "title": "QuoteRequested v1 - data",
  "description": "Multi-quote requested. Producer: quotation. Status: IMPLEMENTED (DynamoDB OUTBOX item; envelope pending). The `data` member of event-envelope/v1 (ADR-025): ids and states only, never customer PII.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "quoteId",
    "journeyId"
  ],
  "properties": {
    "quoteId": {
      "$ref": "#/$defs/ulid"
    },
    "journeyId": {
      "$ref": "#/$defs/ulid"
    },
    "productClass": {
      "type": "string",
      "enum": [
        "TERM",
        "SAVINGS",
        "ULIP"
      ]
    },
    "customerId": {
      "$ref": "#/$defs/ulid"
    }
  },
  "$defs": {
    "ulid": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    }
  }
}
