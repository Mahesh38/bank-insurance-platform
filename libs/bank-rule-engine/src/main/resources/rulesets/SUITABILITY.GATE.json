{
  "format": "rule-set/v1",
  "ruleSetId": "SUITABILITY.GATE",
  "domain": "SUITABILITY_GATE",
  "scope": {
    "lob": "LIFE",
    "productClass": null
  },
  "version": "1.0.0",
  "effectiveFrom": "2026-11-01T00:00:00+05:30",
  "effectiveTo": null,
  "classification": "COMPLIANCE",
  "pinning": "NONE",
  "description": "SUIT-R20 quote gate policy: which per-class outcomes permit a quote, caution acknowledgement, validity window. The gate itself is code and cannot be disabled (SUIT-R40).",
  "source": {
    "document": "docs/au-bank-insurance-platform/rule-packs/suitability-rule-pack.md",
    "sections": [
      "1 (SUIT-R20)",
      "5 (validUntil = evaluatedAt + 30 days)",
      "6.1-6.2 (gate and seven mandatory cases)",
      "7.2 (SUIT-R41/R42 caution acknowledgement)"
    ],
    "decisions": [
      "ADR-024 section 7",
      "DECISIONS-2026-10-21 D3 (customerId replaces CIF)",
      "D4 (allowedOutcomes)"
    ]
  },
  "governance": {
    "status": "DRAFT-awaiting-approval",
    "signatureStatus": "AI-DRAFTED - mandatory content-owner approval outstanding (ADR-024 section 7)",
    "contentApprovers": [
      "Shailja / bank Compliance"
    ],
    "approverRole": "COMPLIANCE_APPROVER",
    "seededBy": "SUG-20261021-rul (owner-directed build, ADMIT-BYPASS)",
    "openItems": [
      "OPEN-SUIT-04 30-day validity regulator-acceptable"
    ]
  },
  "inputs": [
    {
      "name": "asOf",
      "type": "DATE",
      "required": true,
      "description": "Date of the quote request (caller's clock)"
    },
    {
      "name": "productClass",
      "type": "ENUM",
      "required": true,
      "values": [
        "TERM",
        "SAVINGS",
        "ULIP"
      ]
    },
    {
      "name": "requestCustomerId",
      "type": "STRING",
      "required": true
    },
    {
      "name": "evaluationId",
      "type": "STRING",
      "required": false
    },
    {
      "name": "evaluationFound",
      "type": "BOOLEAN",
      "required": false
    },
    {
      "name": "evaluationStatus",
      "type": "ENUM",
      "required": false,
      "values": [
        "ACTIVE",
        "EXPIRED",
        "INVALIDATED",
        "SUPERSEDED"
      ]
    },
    {
      "name": "evaluatedAt",
      "type": "DATE",
      "required": false
    },
    {
      "name": "evaluationCustomerId",
      "type": "STRING",
      "required": false
    },
    {
      "name": "outcomeForClass",
      "type": "ENUM",
      "required": false,
      "values": [
        "SUITABLE",
        "SUITABLE_WITH_CAUTION",
        "NOT_SUITABLE",
        "INSUFFICIENT_DATA"
      ]
    },
    {
      "name": "cautionAcknowledged",
      "type": "BOOLEAN",
      "required": false
    }
  ],
  "decision": {
    "hitPolicy": "PRIORITY",
    "outcomeRank": [
      "DENY",
      "ALLOW"
    ],
    "noMatchOutcome": "DENY",
    "noMatchReasonCode": "SUITABILITY_EVALUATION_INVALID",
    "missingInputOutcome": "DENY",
    "missingConfigOutcome": "DENY",
    "missingConfigReasonCode": "SUITABILITY_GATE_CONFIG_MISSING",
    "collectReasonCodes": "WINNING_ONLY"
  },
  "rules": [
    {
      "ruleId": "GATE-01",
      "priority": 1,
      "when": {
        "op": "isNull",
        "args": [
          {
            "var": "evaluationId"
          }
        ]
      },
      "then": {
        "outcome": "DENY",
        "reasonCode": "SUITABILITY_EVALUATION_REQUIRED"
      },
      "sourceRef": "section 6.2 case 1"
    },
    {
      "ruleId": "GATE-02",
      "priority": 2,
      "when": {
        "op": "all",
        "args": [
          {
            "op": "isPresent",
            "args": [
              {
                "var": "evaluationId"
              }
            ]
          },
          {
            "op": "not",
            "args": [
              {
                "op": "eq",
                "args": [
                  {
                    "var": "evaluationFound"
                  },
                  {
                    "const": true
                  }
                ]
              }
            ]
          }
        ]
      },
      "then": {
        "outcome": "DENY",
        "reasonCode": "SUITABILITY_EVALUATION_NOT_FOUND"
      },
      "sourceRef": "section 6.2 case 2"
    },
    {
      "ruleId": "GATE-03",
      "priority": 3,
      "when": {
        "op": "gt",
        "args": [
          {
            "op": "daysBetween",
            "args": [
              {
                "var": "evaluatedAt"
              },
              {
                "var": "asOf"
              }
            ]
          },
          {
            "param": "validityDays"
          }
        ]
      },
      "then": {
        "outcome": "DENY",
        "reasonCode": "SUITABILITY_EVALUATION_EXPIRED"
      },
      "sourceRef": "section 6.2 case 3"
    },
    {
      "ruleId": "GATE-04",
      "priority": 4,
      "when": {
        "op": "ne",
        "args": [
          {
            "var": "evaluationCustomerId"
          },
          {
            "var": "requestCustomerId"
          }
        ]
      },
      "then": {
        "outcome": "DENY",
        "reasonCode": "SUITABILITY_SUBJECT_MISMATCH",
        "actions": [
          "SECURITY_EVENT"
        ]
      },
      "sourceRef": "section 6.2 case 4 (SUIT-R36)"
    },
    {
      "ruleId": "GATE-05",
      "priority": 5,
      "when": {
        "op": "eq",
        "args": [
          {
            "var": "outcomeForClass"
          },
          {
            "const": "NOT_SUITABLE"
          }
        ]
      },
      "then": {
        "outcome": "DENY",
        "reasonCode": "PRODUCT_CLASS_NOT_SUITABLE"
      },
      "sourceRef": "section 6.2 case 5 (SUIT-R38)"
    },
    {
      "ruleId": "GATE-06",
      "priority": 6,
      "when": {
        "op": "eq",
        "args": [
          {
            "var": "outcomeForClass"
          },
          {
            "const": "INSUFFICIENT_DATA"
          }
        ]
      },
      "then": {
        "outcome": "DENY",
        "reasonCode": "SUITABILITY_INSUFFICIENT_DATA"
      },
      "sourceRef": "section 6.2 case 6 (SUIT-R39)"
    },
    {
      "ruleId": "GATE-07",
      "priority": 7,
      "when": {
        "op": "in",
        "args": [
          {
            "var": "evaluationStatus"
          },
          {
            "const": [
              "EXPIRED",
              "INVALIDATED",
              "SUPERSEDED"
            ]
          }
        ]
      },
      "then": {
        "outcome": "DENY",
        "reasonCode": "SUITABILITY_EVALUATION_INVALID"
      },
      "sourceRef": "section 6.2 case 7"
    },
    {
      "ruleId": "GATE-08",
      "priority": 8,
      "when": {
        "op": "all",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "var": "outcomeForClass"
              },
              {
                "const": "SUITABLE_WITH_CAUTION"
              }
            ]
          },
          {
            "op": "eq",
            "args": [
              {
                "param": "cautionAcknowledgementRequired"
              },
              {
                "const": true
              }
            ]
          },
          {
            "op": "not",
            "args": [
              {
                "op": "eq",
                "args": [
                  {
                    "var": "cautionAcknowledged"
                  },
                  {
                    "const": true
                  }
                ]
              }
            ]
          }
        ]
      },
      "then": {
        "outcome": "DENY",
        "reasonCode": "SUITABILITY_CAUTION_NOT_ACKNOWLEDGED"
      },
      "sourceRef": "section 7.2 SUIT-R41/R42"
    },
    {
      "ruleId": "GATE-09",
      "priority": 9,
      "when": {
        "op": "all",
        "args": [
          {
            "op": "isPresent",
            "args": [
              {
                "var": "outcomeForClass"
              }
            ]
          },
          {
            "op": "notIn",
            "args": [
              {
                "var": "outcomeForClass"
              },
              {
                "param": "allowedOutcomes"
              }
            ]
          }
        ]
      },
      "then": {
        "outcome": "DENY",
        "reasonCode": "PRODUCT_CLASS_NOT_PERMITTED"
      },
      "sourceRef": "DECISIONS D4: allowedOutcomes is configuration"
    },
    {
      "ruleId": "GATE-ALLOW",
      "priority": 100,
      "sourceRef": "SUIT-R20 all four conditions",
      "when": {
        "op": "all",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "var": "evaluationFound"
              },
              {
                "const": true
              }
            ]
          },
          {
            "op": "eq",
            "args": [
              {
                "var": "evaluationStatus"
              },
              {
                "const": "ACTIVE"
              }
            ]
          },
          {
            "op": "lte",
            "args": [
              {
                "op": "daysBetween",
                "args": [
                  {
                    "var": "evaluatedAt"
                  },
                  {
                    "var": "asOf"
                  }
                ]
              },
              {
                "param": "validityDays"
              }
            ]
          },
          {
            "op": "eq",
            "args": [
              {
                "var": "evaluationCustomerId"
              },
              {
                "var": "requestCustomerId"
              }
            ]
          },
          {
            "op": "in",
            "args": [
              {
                "var": "outcomeForClass"
              },
              {
                "param": "allowedOutcomes"
              }
            ]
          }
        ]
      },
      "then": {
        "outcome": "ALLOW",
        "reasonCode": null
      }
    }
  ],
  "parameters": {
    "allowedOutcomes": [
      "SUITABLE",
      "SUITABLE_WITH_CAUTION"
    ],
    "cautionAcknowledgementRequired": true,
    "validityDays": 30
  },
  "reasonCodes": {
    "RULE_INPUT_MISSING": {
      "severity": "BLOCK",
      "rmText": "Required inputs missing: @missing.",
      "customerText": null
    },
    "RULE_INPUT_INVALID": {
      "severity": "BLOCK",
      "rmText": "Inputs not in the expected form: @missing.",
      "customerText": null
    },
    "SUITABILITY_EVALUATION_REQUIRED": {
      "severity": "BLOCK",
      "rmText": "No suitability evaluation id on the request.",
      "customerText": "A completed suitability assessment is needed before this quote can be produced."
    },
    "SUITABILITY_EVALUATION_NOT_FOUND": {
      "severity": "BLOCK",
      "rmText": "Suitability evaluation not found.",
      "customerText": "A completed suitability assessment is needed before this quote can be produced."
    },
    "SUITABILITY_EVALUATION_EXPIRED": {
      "severity": "BLOCK",
      "rmText": "Suitability evaluation is older than the validity window.",
      "customerText": "A completed suitability assessment is needed before this quote can be produced."
    },
    "SUITABILITY_SUBJECT_MISMATCH": {
      "severity": "BLOCK",
      "rmText": "Suitability evaluation belongs to a different customer (security event).",
      "customerText": "A completed suitability assessment is needed before this quote can be produced."
    },
    "PRODUCT_CLASS_NOT_SUITABLE": {
      "severity": "BLOCK",
      "rmText": "Outcome for the requested product class is NOT_SUITABLE.",
      "customerText": "This type of plan is not suitable for you."
    },
    "SUITABILITY_INSUFFICIENT_DATA": {
      "severity": "BLOCK",
      "rmText": "Outcome for the requested product class is INSUFFICIENT_DATA.",
      "customerText": "A completed suitability assessment is needed before this quote can be produced."
    },
    "SUITABILITY_EVALUATION_INVALID": {
      "severity": "BLOCK",
      "rmText": "Suitability evaluation is not ACTIVE (expired, invalidated or superseded).",
      "customerText": "A completed suitability assessment is needed before this quote can be produced."
    },
    "SUITABILITY_CAUTION_NOT_ACKNOWLEDGED": {
      "severity": "BLOCK",
      "rmText": "Caution disclosure not yet acknowledged on the customer's device (SUIT-R41/R42).",
      "customerText": "Please read and acknowledge the caution before continuing."
    },
    "PRODUCT_CLASS_NOT_PERMITTED": {
      "severity": "BLOCK",
      "rmText": "Outcome for the requested class is not in SUITABILITY.GATE allowedOutcomes.",
      "customerText": "A completed suitability assessment is needed before this quote can be produced."
    },
    "SUITABILITY_GATE_CONFIG_MISSING": {
      "severity": "BLOCK",
      "rmText": "Gate configuration incomplete (@missingParameters).",
      "customerText": "A completed suitability assessment is needed before this quote can be produced."
    }
  },
