        ]
      }
    },
    {
      "name": "SUIT-R08-age-17",
      "inputs": {
        "ageNextBirthday": 17,
        "annualIncome": 1200000,
        "declaredPremium": 25000,
        "tobaccoUse": false,
        "occupationCategory": "SALARIED",
        "declinedOrRated": "NO",
        "replacingExistingPolicy": false,
        "primaryObjective": "WEALTH_GROWTH",
        "investmentHorizon": "GT_20Y",
        "riskAttitude": "HIGH"
      },
      "expect": {
        "outcome": "NOT_SUITABLE",
        "reasonCodes": [
          "AGE_OUTSIDE_ELIGIBLE_RANGE"
        ]
      }
    },
    {
      "name": "GAP-affordability-above-0.20-no-rule",
      "inputs": {
        "ageNextBirthday": 38,
        "annualIncome": 1200000,
        "declaredPremium": 300000,
        "tobaccoUse": false,
        "occupationCategory": "SALARIED",
        "declinedOrRated": "NO",
        "replacingExistingPolicy": false,
        "primaryObjective": "WEALTH_GROWTH",
        "investmentHorizon": "GT_20Y",
        "riskAttitude": "HIGH"
      },
      "expect": {
        "outcome": "INSUFFICIENT_DATA",
        "reasonCodes": [
          "NO_RULE_MATCHED"
        ]
      }
    }
  ]
}
