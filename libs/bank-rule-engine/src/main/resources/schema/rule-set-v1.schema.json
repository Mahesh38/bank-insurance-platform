{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bank.internal/schemas/rule-set-v1.schema.json",
  "title": "rule-set/v1",
  "description": "ADR-024 rule-set document. Structure only; RuleSetValidator adds the semantic checks (unknown vars/params/tables, derive cycles, undefined reason codes and outcomes).",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "ruleSetId", "domain", "scope", "version", "effectiveFrom", "classification", "inputs", "decision", "rules", "reasonCodes", "testCases"],
  "properties": {
    "format": { "const": "rule-set/v1" },
    "ruleSetId": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*(\\.[A-Z0-9_]+)*$" },
    "domain": { "type": "string", "minLength": 1 },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lob": { "type": ["string", "null"] },
        "productClass": { "type": ["string", "null"] }
      }
    },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "effectiveFrom": { "type": "string", "format": "date-time" },
    "effectiveTo": { "type": ["string", "null"], "format": "date-time" },
    "classification": { "enum": ["COMPLIANCE", "PRODUCT", "OPERATIONAL"] },
    "pinning": { "enum": ["JOURNEY", "NONE"] },
    "scale": { "type": "integer", "minimum": 0 },
    "description": { "type": "string" },
    "source": {
      "description": "Where the content came from (rule pack / BRD section). Free-form, not evaluated.",
      "type": ["object", "array", "string"]
    },
    "governance": {
      "description": "Content-approval metadata (ADR-024 section 7). Read by administration-config-service, ignored by the engine.",
      "type": "object"
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "type": { "enum": ["INTEGER", "DECIMAL", "STRING", "BOOLEAN", "DATE", "ENUM", "LIST"] },
          "required": { "type": "boolean" },
          "values": { "type": "array", "items": { "type": "string" } },
          "description": { "type": "string" },
          "sourceRef": { "type": "string" }
        },
        "if": { "properties": { "type": { "const": "ENUM" } } },
        "then": { "required": ["values"], "properties": { "values": { "minItems": 1 } } }
      }
    },
    "tables": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "rows"],
        "properties": {
          "type": { "enum": ["RANGE", "EXACT"] },
          "key": { "type": "string" },
          "description": { "type": "string" },
          "rows": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["value"],
              "properties": {
                "from": { "type": "number" },
                "to": { "type": ["number", "null"] },
                "key": {},
                "value": {},
                "label": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "derive": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "expr"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "expr": { "$ref": "#/$defs/expr" },
          "scale": { "type": "integer", "minimum": 0 },
          "description": { "type": "string" }
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hitPolicy", "noMatchOutcome", "missingInputOutcome"],
      "properties": {
        "hitPolicy": { "enum": ["PRIORITY", "FIRST", "COLLECT"] },
        "outcomeRank": { "type": "array", "items": { "type": "string" } },
        "noMatchOutcome": { "type": "string" },
        "noMatchReasonCode": { "type": "string" },
        "missingInputOutcome": { "type": "string" },
        "missingConfigOutcome": { "type": "string" },
        "missingConfigReasonCode": { "type": "string" },
        "collectReasonCodes": { "enum": ["ALL_FIRED", "WINNING_ONLY"] }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ruleId", "priority", "when", "then"],
        "properties": {
          "ruleId": { "type": "string", "minLength": 1 },
          "priority": { "type": "integer" },
          "description": { "type": "string" },
          "sourceRef": { "type": "string" },
          "when": { "$ref": "#/$defs/expr" },
          "then": {
            "type": "object",
            "additionalProperties": false,
            "required": ["outcome"],
            "properties": {
              "outcome": {
                "oneOf": [
                  { "type": "string" },
                  { "$ref": "#/$defs/paramRef" }
                ]
              },
              "reasonCode": { "type": ["string", "null"] },
              "params": { "type": "object", "additionalProperties": { "$ref": "#/$defs/expr" } },
              "actions": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "parameters": { "type": "object" },
    "reasonCodes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "rmText"],
        "properties": {
          "severity": { "enum": ["INFO", "CAUTION", "APPROVAL", "BLOCK"] },
          "rmText": { "type": "string" },
          "customerText": { "type": ["string", "null"] }
        }
      }
    },
    "testCases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "inputs", "expect"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "inputs": { "type": "object" },
          "evaluatedAt": { "type": "string" },
          "sample": { "type": "boolean" },
          "expect": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "outcome": { "type": ["string", "null"] },
              "reasonCodes": { "type": "array", "items": { "type": "string" } },
              "fired": { "type": "array", "items": { "type": "string" } },
              "derived": { "type": "object" },
              "messages": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "paramRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["param"],
      "properties": { "param": { "type": "string", "minLength": 1 } }
    },
    "expr": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["var"],
          "properties": { "var": { "type": "string", "minLength": 1 } }
        },
        { "$ref": "#/$defs/paramRef" },
        {
          "type": "object", "additionalProperties": false, "required": ["const"],
          "properties": { "const": {} }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["op", "args"],
          "properties": {
            "op": {
              "enum": ["all", "any", "not", "eq", "ne", "gt", "gte", "lt", "lte", "in", "notIn", "between", "isNull", "isPresent",
                       "add", "sub", "mul", "div", "min", "max", "abs",
                       "roundUpTo", "lookup", "daysBetween", "ageAt", "coalesce"]
            },
            "args": { "type": "array", "items": { "$ref": "#/$defs/expr" } }
          }
        }
      ]
    }
  }
}
