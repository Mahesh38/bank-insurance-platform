# Local development — H2 in PostgreSQL compatibility mode
spring:
  datasource:
    url: jdbc:h2:mem:persistence_local;MODE=PostgreSQL;DB_CLOSE_DELAY=-1;NON_KEYWORDS=VALUE
    driver-class-name: org.h2.Driver
    username: sa
    password:
  h2:
    console:
      enabled: true
      path: /h2-console

  jpa:
    show-sql: true

# Dev-only AES-256 key — never reuse in uat/prod. Generate your own with: openssl rand -base64 32
raw-payload:
  encryption:
    key: lo9brrfnf6z7mhenhZfaKMXychPqEjzRtm2zCZKDUos=

logging:
  level:
    com.bank.persistence: DEBUG
    org.flywaydb: DEBUG
