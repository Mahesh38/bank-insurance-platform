# Copy to application-local.yml for local overrides (not committed).
# Example for JPA services — adjust env prefix for your module.

spring:
  datasource:
    url: jdbc:h2:mem:proposal_service;MODE=PostgreSQL;DB_CLOSE_DELAY=-1
    driver-class-name: org.h2.Driver
    username: sa
    password:
  jpa:
    hibernate:
      ddl-auto: validate
    open-in-view: false
  flyway:
    enabled: true
    locations: classpath:db/migration,classpath:db/vendor/{vendor}
    validate-on-migrate: true

# DynamoDB Local (schemas/20 §5); the table is created by a fixture mirroring Terraform.
proposal:
  working-store:
    endpoint-override: http://localhost:8000
  envelope:
    provider: local
    # 32 random bytes, base64. Local only — never a real key.
    local-key: AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
    local-key-id: local-dev
